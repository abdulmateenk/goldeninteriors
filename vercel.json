{
 "headers": [
  {
   "source": "/(.*)\\.(png|jpg|jpeg|webp|ico)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=604800"
    }
   ]
  },
  {
   "source": "/(.*)\\.(css|js)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=0, must-revalidate"
    }
   ]
  },
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    }
   ]
  }
 ],
 "cleanUrls": true,
 "trailingSlash": false,
 "redirects": [
  {
   "source": "/new-arrivals",
   "destination": "/new-arrival",
   "permanent": true
  }
 ]
}